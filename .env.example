# ---------- Obligatorias ----------
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require   # usar la URL "pooled" de Neon/Supabase
ANTHROPIC_API_KEY=sk-ant-...
CRON_SECRET=                      # openssl rand -hex 32  (Vercel lo envía solo en los cron)
APP_URL=https://tu-proyecto.vercel.app

# ---------- Login "Conectar con Google" (correo + Drive + Sheet de cada persona) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=                   # openssl rand -base64 32  (cifra los tokens guardados; no la pierdas)
USUARIOS_PERMITIDOS=@tuempresa.com,persona@gmail.com   # quién puede conectarse. Vacío = nadie

# Carpeta "03. Facturas" y hoja de registro de la empresa (opcional). Si se definen, todos archivan ahí
# (cada persona debe tener permiso de edición) y al conectar se pide acceso completo a Drive.
DRIVE_FOLDER_ID=
SHEETS_SPREADSHEET_ID=

# ---------- Slack ----------
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789
SLACK_SIGNING_SECRET=
NOTIFICAR_DESDE=                  # opcional, ISO (2026-11-12T00:00:00Z): lo recibido antes no se anuncia en Slack

# ---------- Opcional: buzones fijos que NO son Google (Outlook, Zoho, hosting propio...) ----------
# [{"id":"contabilidad","host":"outlook.office365.com","user":"conta@empresa.com","desde":"2026-11-01",
#   "auth":{"tipo":"password","password":"..."}}]
# auth oauth2: {"tipo":"oauth2","token_url":"...","client_id":"...","client_secret":"...","refresh_token":"..."}
MAILBOXES_JSON=[]
# Destino de los buzones fijos (cuenta de servicio; comparte el Sheet y una Unidad Compartida con su correo):
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- Ajustes ----------
SHEETS_TAB=Registro de facturas
CLAUDE_MODEL=claude-opus-5-5
MAX_CORREOS_POR_EJECUCION=20
MAX_INTENTOS=3
TZ_NEGOCIO=America/Bogota
